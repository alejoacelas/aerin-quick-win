{
  "rewrites": [
    {
      "source": "/query",
      "destination": "/api/search"
    },
    {
      "source": "/catalog",
      "destination": "/api/catalog"
    },
    {
      "source": "/prompt",
      "destination": "/agent-instructions.md"
    }
  ],
  "headers": [
    {
      "source": "/agent-instructions.md",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/markdown; charset=utf-8"
        }
      ]
    }
  ]
}
